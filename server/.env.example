# Copy this file to `.env` in the server/ folder and fill the values.
# The anon (public) key is safe to keep in the client build; the service
# role key must never be bundled or committed.

# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Supabase anon (public) key
SUPABASE_ANON_KEY=

# Optional: the service-role key is used only server-side. Which key the
# server should use can be switched later without touching the client.
# SUPABASE_SERVICE_ROLE_KEY=