# ── Be Native · Cultural Vibe Mapper — client provider defaults ─────────
# Fallback defaults keep the app fully functional in local MOCK mode.
# Copy to `.env` and fill keys only when you want real providers (TTS /
# LLM / voice clone still NEVER render Arabic audio — English Gen Z only).

VITE_LLM_PROVIDER=MOCK
VITE_LLM_API_KEY=

VITE_TTS_PROVIDER=MOCK
VITE_TTS_API_KEY=

VITE_VOICE_CLONE_PROVIDER=MOCK
VITE_VOICE_CLONE_API_KEY=